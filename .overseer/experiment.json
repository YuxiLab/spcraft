{
  "target": "bench_ompspmv",
  "parameters": [
    {
      "label": "Datasets",
      "choices": [
        {
          "path": "dataset/output/SiO2/SiO2.mtx",
          "id": "SiO2"
        },
        {
          "path": "dataset/output/TSOPF_FS_b300_c2/TSOPF_FS_b300_c2.mtx",
          "id": "TSOPF_FS_b300_c2"
        },
        {
          "path": "dataset/output/TSOPF_FS_b300_c2/TSOPF_FS_b300_c2_b.mtx",
          "id": "TSOPF_FS_b300_c2_b"
        },
        {
          "path": "dataset/output/af_shell10/af_shell10.mtx",
          "id": "af_shell10"
        },
        {
          "path": "dataset/output/consph/consph.mtx",
          "id": "consph"
        },
        {
          "path": "dataset/output/gupta3/gupta3.mtx",
          "id": "gupta3"
        },
        {
          "path": "dataset/output/pdb1HYS/pdb1HYS.mtx",
          "id": "pdb1HYS"
        },
        {
          "path": "dataset/output/rma10/rma10.mtx",
          "id": "rma10"
        },
        {
          "path": "dataset/output/rma10/rma10_b.mtx",
          "id": "rma10_b"
        },
        {
          "path": "dataset/output/webbase-1M/webbase-1M.mtx",
          "id": "webbase-1M"
        }
      ],
      "source": {
        "pattern": "*.mtx",
        "directory": "dataset/output"
      },
      "id": "dataset",
      "selected": [
        "pdb1HYS"
      ]
    },
    {
      "label": "Threads",
      "choices": [
        1,
        2,
        4,
        8,
        16
      ],
      "args": [

      ],
      "requirements": {
        "cpus": "${value}"
      },
      "id": "threads",
      "selected": [
        "4"
      ],
      "template": "threads"
    },
    {
      "label": "Methods / variants",
      "id": "method",
      "choices": [
        {
          "label": "OpenMP · float",
          "id": "openmp-float",
          "args": [
            "--precision",
            "float"
          ]
        },
        {
          "label": "OpenMP · double",
          "id": "openmp-double",
          "args": [
            "--precision",
            "double"
          ]
        }
      ],
      "selected": [
        "openmp-double"
      ]
    }
  ],
  "args": [
    "--matrix",
    "${dataset}",
    "--threads",
    "${threads}",
    "--index",
    "int32",
    "--offset",
    "int32",
    "--iterations",
    "5",
    "--max-time",
    "0.05",
    "--output",
    "${result}"
  ],
  "output_dir": "results/overseer",
  "build": {
    "before_run": true,
    "jobs": 4,
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}",
        "-DSPCRAFT_BUILD_BENCHMARKS=ON"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ],
    "directory": "build/overseer-options"
  },
  "stop_on_failure": false,
  "project": "..",
  "name": "SpMV development",
  "environment": {
    "OMP_NUM_THREADS": "${threads}"
  },
  "version": 2,
  "servers": {
    "selected": [
      "local"
    ],
    "choices": [
      {
        "kind": "local",
        "id": "local"
      },
      {
        "enabled": false,
        "project_dir": "",
        "id": "server1",
        "host": "",
        "kind": "ssh"
      },
      {
        "id": "server1-gpu",
        "extends": "server1",
        "slurm": {
          "gpus": 1,
          "time": "00:15:00",
          "cpus_per_task": 4
        }
      },
      {
        "id": "server1-h100",
        "extends": "server1-gpu",
        "slurm": {
          "constraint": "h100"
        }
      },
      {
        "id": "server1-a100",
        "extends": "server1-gpu",
        "slurm": {
          "constraint": "a100"
        }
      },
      {
        "enabled": false,
        "project_dir": "",
        "id": "server2",
        "host": "",
        "kind": "ssh"
      },
      {
        "enabled": false,
        "project_dir": "",
        "id": "server3",
        "host": "",
        "kind": "ssh"
      }
    ]
  },
  "binary": "build/overseer-options/bin/bench_ompspmv",
  "preset": "openmp-examples"
}
