{
  "args": [
    "--matrix",
    "${dataset}",
    "--profiler-warmup",
    "${warmup}"
  ],
  "stop_on_failure": true,
  "output_dir": "results/overseer",
  "binary": "build/profiler/bin/e08_summa_2d_${measurement}",
  "version": 2,
  "target": "e08_summa_2d_measurements",
  "environment": {
    "OMP_NUM_THREADS": "${threads}"
  },
  "project": "../..",
  "build": {
    "jobs": 4,
    "directory": "build/profiler",
    "before_run": true,
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ]
  },
  "parameters": [
    {
      "label": "Datasets",
      "source": {
        "directory": "datasets",
        "pattern": "*.mtx"
      },
      "id": "dataset",
      "selected": [
        "output/1138_bus/1138_bus"
      ],
      "choices": [
        {
          "label": "output/1138_bus/1138_bus",
          "id": "output/1138_bus/1138_bus",
          "path": "datasets/output/1138_bus/1138_bus.mtx"
        },
        {
          "label": "output/494_bus/494_bus",
          "id": "output/494_bus/494_bus",
          "path": "datasets/output/494_bus/494_bus.mtx"
        },
        {
          "label": "output/662_bus/662_bus",
          "id": "output/662_bus/662_bus",
          "path": "datasets/output/662_bus/662_bus.mtx"
        },
        {
          "label": "output/685_bus/685_bus",
          "id": "output/685_bus/685_bus",
          "path": "datasets/output/685_bus/685_bus.mtx"
        },
        {
          "label": "Bundled SUMMA smoke matrix",
          "id": "summa_2d",
          "path": "examples/spcraft/inputs/summa_2d.mtx"
        }
      ]
    },
    {
      "label": "Threads per rank",
      "requirements": {
        "cpus": "${value}"
      },
      "id": "threads",
      "selected": [
        "1"
      ],
      "choices": [
        1,
        2,
        4
      ]
    },
    {
      "label": "MPI process grid",
      "id": "grid",
      "selected": [
        "2x2"
      ],
      "choices": [
        {
          "launcher": [
            "mpiexec",
            "-n",
            "1"
          ],
          "id": "1x1",
          "args": [
            "--grid-rows",
            "1",
            "--grid-cols",
            "1"
          ]
        },
        {
          "launcher": [
            "mpiexec",
            "-n",
            "4"
          ],
          "id": "2x2",
          "args": [
            "--grid-rows",
            "2",
            "--grid-cols",
            "2"
          ]
        }
      ]
    },
    {
      "id": "measurement",
      "label": "Measurement mode",
      "selected": [
        "profile"
      ],
      "choices": [
        {
          "id": "profile",
          "label": "Phase breakdown (Caliper)"
        },
        {
          "id": "benchmark",
          "label": "Overall timing (native library)"
        }
      ]
    },
    {
      "id": "warmup",
      "label": "Warmup repetitions",
      "selected": [
        "1"
      ],
      "choices": [
        0,
        1,
        3,
        5
      ]
    },
    {
      "id": "budget",
      "label": "Measurement budget",
      "selected": [
        "1000"
      ],
      "choices": [
        {
          "id": "10",
          "label": "10 repetitions",
          "args": [
            "--profiler-repeat",
            "10"
          ]
        },
        {
          "id": "100",
          "label": "100 repetitions",
          "args": [
            "--profiler-repeat",
            "100"
          ]
        },
        {
          "id": "1000",
          "label": "1000 repetitions",
          "args": [
            "--profiler-repeat",
            "1000"
          ]
        },
        {
          "id": "10s",
          "label": "10 seconds",
          "args": [
            "--profiler-seconds",
            "10"
          ]
        }
      ]
    }
  ],
  "name": "Local SUMMA profiling",
  "preset": "profiler",
  "servers": {
    "choices": [
      {
        "kind": "local",
        "id": "local"
      }
    ],
    "selected": [
      "local"
    ]
  }
}
