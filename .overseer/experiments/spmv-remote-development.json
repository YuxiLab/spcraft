{
  "environment": {
    "OMP_NUM_THREADS": "${threads}"
  },
  "project": "../..",
  "binary": "build/overseer-options/bin/bench_ompspmv",
  "output_dir": "results/overseer",
  "build": {
    "before_run": true,
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}",
        "-DSPCRAFT_BUILD_BENCHMARKS=ON"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ],
    "directory": "build/overseer-options",
    "jobs": 4
  },
  "version": 2,
  "target": "bench_ompspmv",
  "args": [
    "--matrix",
    "${dataset}",
    "--threads",
    "${threads}",
    "--index",
    "int32",
    "--offset",
    "int32",
    "--iterations",
    "5",
    "--max-time",
    "0.05",
    "--output",
    "${result}"
  ],
  "stop_on_failure": false,
  "parameters": [
    {
      "source": {
        "pattern": "*.mtx",
        "directory": "dataset/output"
      },
      "selected": [
        "gupta3",
        "pdb1HYS"
      ],
      "choices": [
        {
          "path": "dataset/output/SiO2/SiO2.mtx",
