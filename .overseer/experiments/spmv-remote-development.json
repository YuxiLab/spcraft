{
  "sync": {
    "mounts": [
      "dataset",
      "datasets"
    ],
    "on_save": true,
    "exclude": [
      "latex/",
      "notebook/",
      "doxygen/"
    ]
  },
  "preset": "macos-openmp",
  "name": "SpGEMM example development",
  "environment": {
    "OMP_NUM_THREADS": "${threads}"
  },
  "output_dir": "results/overseer",
  "servers": {
    "selected": [
      "local"
    ],
    "choices": [
      {
        "id": "local",
        "kind": "local"
      },
      {
        "kind": "ssh",
        "enabled": false,
        "host": "",
        "id": "server1",
        "project_dir": ""
      },
      {
        "extends": "server1",
        "id": "server1-gpu",
        "slurm": {
          "cpus_per_task": 4,
          "time": "00:15:00",
          "gpus": 1
        }
      },
      {
        "extends": "server1-gpu",
        "id": "server1-h100",
        "slurm": {
          "constraint": "h100"
        }
      },
      {
        "extends": "server1-gpu",
        "id": "server1-a100",
        "slurm": {
          "constraint": "a100"
        }
      },
      {
        "kind": "ssh",
        "enabled": false,
        "host": "",
        "id": "server2",
        "project_dir": ""
      },
      {
        "kind": "ssh",
        "enabled": false,
        "host": "",
        "id": "server3",
        "project_dir": ""
      },
      {
        "kind": "ssh",
        "environment": {
          "CPM_SOURCE_CACHE": "/home/exouser/.cache/CPM"
        },
        "host": "jet",
        "id": "jet",
        "project_dir": "/home/exouser/.local/share/omo/projects/spcraft"
      },
      {
        "kind": "ssh",
        "environment": {
          "CPM_SOURCE_CACHE": "/u/yuxihong/.cache/CPM"
        },
        "id": "lair",
        "slurm_batch": {
          "qos": "normal"
        },
        "host": "lair",
        "slurm": {
          "partition": "general",
          "account": "yuxilab",
          "cpus_per_task": 4,
          "time": "00:10:00",
          "qos": "interactive",
          "memory": "8G",
          "ntasks": 1,
          "nodes": 1
        },
        "project_dir": "/u/yuxihong/workspace/omo-spcraft"
      },
      {
        "extends": "lair",
        "id": "lair-cpu",
        "slurm": {
          "constraint": "cpujobs"
        }
      },
      {
        "extends": "lair",
        "id": "lair-gpu",
        "slurm": {
          "gpus_per_node": 1
        }
      }
    ]
  },
  "stop_on_failure": false,
  "build": {
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}",
        "-DSPCRAFT_BUILD_BENCHMARKS=ON"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ],
    "jobs": 4,
    "before_run": true,
    "directory": "build/macos-openmp"
  },
  "target": "ex02_spgemm",
  "project": "../..",
  "version": 2,
  "args": [
    "--matrix",
    "${dataset}",
    "--it",
    "int32",
    "--ot",
    "int32"
  ],
  "binary": "build/macos-openmp/bin/ex02_spgemm",
  "parameters": [
    {
      "selected": [
        "pdb1HYS"
      ],
      "label": "Datasets",
      "choices": [
