      "label": "Datasets",
      "id": "dataset"
    },
    {
      "template": "threads",
      "args": [

      ],
      "label": "Threads",
      "selected": [
        "4"
      ],
      "requirements": {
        "cpus": "${value}"
      },
      "id": "threads",
      "choices": [
        1,
        2,
        4,
        8,
        16
      ]
    },
    {
      "choices": [
        {
          "args": [
            "--precision",
            "float"
          ],
          "label": "OpenMP · float",
          "id": "openmp-float"
        },
        {
          "args": [
            "--precision",
            "double"
          ],
          "label": "OpenMP · double",
          "id": "openmp-double"
        }
      ],
      "id": "method",
      "label": "Methods / variants",
      "selected": [
        "openmp-double"
      ]
