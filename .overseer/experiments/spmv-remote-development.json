  "output_dir": "results/overseer",
  "sync": {
    "exclude": [
      "latex/",
      "notebook/",
      "doxygen/"
    ],
    "mounts": [
      "dataset",
      "datasets"
    ],
    "on_save": true
  },
  "stop_on_failure": false,
  "version": 2,
  "target": "ex02_spgemm",
  "build": {
    "before_run": true,
    "jobs": 4,
    "directory": "build/cuda-openmp",
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}",
        "-DSPCRAFT_BUILD_BENCHMARKS=ON"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ]
  }
