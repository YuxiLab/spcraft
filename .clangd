###################################################################################
# Common settings applied to all files.
# Includes/system paths are pulled from compile_commands.json, so they are
# intentionally not duplicated here. Symlink `build` -> `build_<arch>` locally.
###################################################################################
CompileFlags:
  CompilationDatabase: ./build
  Add:
    # amsparse is header-only, so compile_commands.json has no entry under
    # amsparse/ and clangd would interpolate flags from an unrelated TU (gtest).
    # Paths are relative to the compile command's directory (build/).
    - "-I../include"
    - "-I.."
    - "-isystem"
    - "_deps/fastmatrixmarket-src/include"
    - "-I/opt/nvidia/hpc_sdk/Linux_x86_64/26.5/comm_libs/13.2/hpcx/hpcx-2.50/ompi5/include"

Diagnostics:
  Suppress:
    - "pp_including_mainfile_in_preamble"
    - "builtin_definition"
    - "unused-includes"
    - "variadic_device_fn"
    - "attributes_not_allowed"

Hover:
  ShowAKA: No

InlayHints:
  Enabled: No

---
###################################################################################
# Host C/C++ headers and sources.
###################################################################################

If:
  PathMatch: '.*\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$'
CompileFlags:
  Compiler: /usr/bin/c++
  Add:
    - -I/usr/local/cuda/13.2/targets/x86_64-linux/include
    - --std=c++20
  Remove:
    # strip nvcc-only arguments inherited by compdb header entries
    - "-forward-unknown-to-host-compiler"
    - "-Xfatbin*"
    - "-gencode*"
    - "--generate-code*"
    - "-arch=*"
    - "-Xcompiler=*"
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-Werror=cross-execution-space-call"
    # strip CUDA language forcing so headers parse as host C++
    - "-x"
    - "-xcuda"

---
###################################################################################
# CUDA sources and device headers.
###################################################################################
If:
  PathMatch: '.*\.(cu|cuh)$'
CompileFlags:
  Compiler: /usr/local/cuda/13.2/bin/nvcc
  Add:
    - --cuda-path=/usr/local/cuda/13.2
    - --cuda-gpu-arch=sm_90a
    - -I/usr/local/cuda/13.2/targets/x86_64-linux/include
    - "-isystem"
    - "/usr/lib/gcc/x86_64-linux-gnu/12/include"
    - "-xcuda"
    - "-ferror-limit=0"
    - "--no-cuda-version-check"
    - --std=c++20
    - "-D__INTELLISENSE__"
    - "-D__CLANGD__"
    - "-D__CUDACC__"
    - "-DCUDA_12_0_SM90_FEATURES_SUPPORTED"
    - "-DCUTLASS_ARCH_MMA_SM90_SUPPORTED=1"
    - "-D_LIBCUDACXX_STD_VER=12"
    - "-D__CUDACC_VER_MAJOR__=13"
    - "-D__CUDACC_VER_MINOR__=2"
    - "-D__CUDACC_VER_BUILD__=78"
    - "-D__CUDA_ARCH__=900"
    - "-D__CUDA_ARCH_FEAT_SM90_ALL"
    - "-Wno-invalid-constexpr"
  Remove:
    # strip nvcc-only flags before clang parses CUDA mode
    - "-Xfatbin*"
    - "-gencode*"
    - "--generate-code*"
    - "-arch=*"
    - "-Xcompiler=*"
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
