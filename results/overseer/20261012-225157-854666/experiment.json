{
  "version": 1,
  "name": "SpMV development",
  "project": "../../..",
  "preset": "openmp-examples",
  "target": "bench_ompspmv",
  "binary": "build/overseer-dev/bin/bench_ompspmv",
  "args": [
    "--matrix",
    "${dataset}",
    "--threads",
    "${threads}",
    "--index",
    "int32",
    "--offset",
    "int32",
    "--iterations",
    "5",
    "--max-time",
    "0.05",
    "--output",
    "${result}"
  ],
  "environment": {
    "OMP_NUM_THREADS": "${threads}"
  },
  "datasets": {
    "directory": "dataset/output",
    "choices": [
      {
        "id": "SiO2",
        "path": "dataset/output/SiO2/SiO2.mtx"
      },
      {
        "id": "TSOPF_FS_b300_c2",
        "path": "dataset/output/TSOPF_FS_b300_c2/TSOPF_FS_b300_c2.mtx"
      },
      {
        "id": "TSOPF_FS_b300_c2_b",
        "path": "dataset/output/TSOPF_FS_b300_c2/TSOPF_FS_b300_c2_b.mtx"
      },
      {
        "id": "af_shell10",
        "path": "dataset/output/af_shell10/af_shell10.mtx"
      },
      {
        "id": "consph",
        "path": "dataset/output/consph/consph.mtx"
      },
      {
        "id": "gupta3",
        "path": "dataset/output/gupta3/gupta3.mtx"
      },
      {
        "id": "pdb1HYS",
        "path": "dataset/output/pdb1HYS/pdb1HYS.mtx"
      },
      {
        "id": "rma10",
        "path": "dataset/output/rma10/rma10.mtx"
      },
      {
        "id": "rma10_b",
        "path": "dataset/output/rma10/rma10_b.mtx"
      },
      {
        "id": "webbase-1M",
        "path": "dataset/output/webbase-1M/webbase-1M.mtx"
      }
    ],
    "selected": [
      "gupta3",
      "pdb1HYS"
    ]
  },
  "threads": {
    "choices": [
      1,
      2,
      4,
      8,
      16
    ],
    "selected": [
      1,
      2,
      4
    ]
  },
  "methods": {
    "choices": [
      {
        "id": "openmp-float",
        "label": "OpenMP · float",
        "args": [
          "--precision",
          "float"
        ]
      },
      {
        "id": "openmp-double",
        "label": "OpenMP · double",
        "args": [
          "--precision",
          "double"
        ]
      }
    ],
    "selected": [
      "openmp-float",
      "openmp-double"
    ]
  },
  "servers": {
    "choices": [
      {
        "id": "local",
        "kind": "local"
      },
      {
        "id": "server1",
        "kind": "ssh",
        "host": "",
        "project_dir": "",
        "enabled": false
      },
      {
        "id": "server1-gpu",
        "extends": "server1",
        "slurm": {
          "gpus": 1,
          "cpus_per_task": 4,
          "time": "00:15:00"
        }
      },
      {
        "id": "server1-h100",
        "extends": "server1-gpu",
        "slurm": {
          "constraint": "h100"
        }
      },
      {
        "id": "server1-a100",
        "extends": "server1-gpu",
        "slurm": {
          "constraint": "a100"
        }
      },
      {
        "id": "server2",
        "kind": "ssh",
        "host": "",
        "project_dir": "",
        "enabled": false
      },
      {
        "id": "server3",
        "kind": "ssh",
        "host": "",
        "project_dir": "",
        "enabled": false
      }
    ],
    "selected": [
      "local"
    ]
  },
  "output_dir": "results/overseer",
  "stop_on_failure": false,
  "build": {
    "directory": "build/overseer-dev",
    "jobs": 4,
    "before_run": true,
    "commands": [
      [
        "cmake",
        "--preset",
        "${preset}",
        "-B",
        "${build_dir}",
        "-DSPCRAFT_BUILD_BENCHMARKS=ON"
      ],
      [
        "cmake",
        "--build",
        "${build_dir}",
        "--target",
        "${target}",
        "--parallel",
        "${build_jobs}"
      ]
    ]
  }
}
