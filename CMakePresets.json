{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "config-full",
      "displayName": "Cmake Configure For Clangd",
      "description": "Everything enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SPCRAFT_USE_MPI": true,
        "SPCRAFT_USE_MKL": true,
        "SPCRAFT_USE_CUDA": true,
        "CMAKE_DISABLE_FIND_PACKAGE_OpenMP": false,
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "SPCRAFT_BUILD_EXAMPLES": true,
        "SPCRAFT_BUILD_BENCHMARKS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "cuda-openmp",
      "displayName": "CUDA + OpenMP (RelWithDebInfo)",
      "description": "RelWithDebInfo build with CUDA and OpenMP enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SPCRAFT_USE_CUDA": true,
        "CMAKE_DISABLE_FIND_PACKAGE_OpenMP": false,
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "SPCRAFT_BUILD_EXAMPLES": true,
        "SPCRAFT_BUILD_BENCHMARKS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "cuda-openmp-debug",
      "displayName": "CUDA + OpenMP (Debug)",
      "description": "Debug build with CUDA and OpenMP enabled",
      "inherits": "cuda-openmp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "openmp-examples",
      "displayName": "OpenMP Example Only",
      "description": "OpenMP enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SPCRAFT_USE_MPI": false,
        "SPCRAFT_USE_CUDA": false,
        "SPCRAFT_BUILD_EXAMPLES": true,
        "SPCRAFT_BUILD_DOWNSTREAM": true,
        "SPCRAFT_BUILD_BENCHMARKS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "cpu",
      "displayName": "CPU (oneMKL + OpenMP)",
      "description": "CPU-only RelWithDebInfo build with oneMKL and OpenMP enabled",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SPCRAFT_USE_MPI": false,
        "SPCRAFT_USE_MKL": true,
        "SPCRAFT_USE_CUDA": false,
        "CMAKE_DISABLE_FIND_PACKAGE_OpenMP": false,
        "SPCRAFT_BUILD_EXAMPLES": true
      }
    },
    {
      "name": "macos-openmp",
      "displayName": "macOS + OpenMP + MPI (RelWithDebInfo)",
      "description": "Apple Clang with libomp and MPI; set OpenMP_ROOT to the libomp installation prefix",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cc",
        "CMAKE_CXX_COMPILER": "c++",
        "SPCRAFT_USE_CUDA": false,
        "SPCRAFT_USE_MPI": true,
        "SPCRAFT_USE_MKL": false,
        "CMAKE_DISABLE_FIND_PACKAGE_OpenMP": false,
        "CMAKE_REQUIRE_FIND_PACKAGE_OpenMP": true,
        "OpenMP_ROOT": "$env{OpenMP_ROOT}",
        "SPCRAFT_BUILD_EXAMPLES": true,
        "SPCRAFT_BUILD_DOWNSTREAM": true,
        "SPCRAFT_BUILD_BENCHMARKS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "profiler",
      "displayName": "MPI SUMMA + Caliper",
      "description": "Instrumented CPU build; install MPI-enabled Caliper or set caliper_DIR",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/profiler-caliper-install;$env{CMAKE_PREFIX_PATH}",
        "OpenMP_ROOT": "$env{OpenMP_ROOT}",
        "SPCRAFT_USE_MPI": true,
        "SPCRAFT_USE_CALIPER": true,
        "SPCRAFT_USE_CUDA": false,
        "SPCRAFT_USE_MKL": false,
        "SPCRAFT_BUILD_DOWNSTREAM": true,
        "SPCRAFT_BUILD_EXAMPLES": true,
        "SPCRAFT_BUILD_BENCHMARKS": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "default",
      "displayName": "Default (CUDA + OpenMP)",
      "description": "Default configuration with CUDA and OpenMP enabled",
      "inherits": "cuda-openmp"
    }
  ],
  "buildPresets": [
    {
      "name": "profiler",
      "configurePreset": "profiler",
      "targets": ["e08_summa_2d_profile"]
    },
    {
      "name": "cuda-openmp",
      "displayName": "Build CUDA + OpenMP (RelWithDebInfo)",
      "configurePreset": "cuda-openmp"
    },
    {
      "name": "cuda-openmp-debug",
      "displayName": "Build CUDA + OpenMP (Debug)",
      "configurePreset": "cuda-openmp-debug"
    },
    {
      "name": "default",
      "displayName": "Build Default",
      "configurePreset": "default"
    },
    {
      "name": "examples",
      "displayName": "Build Kernel Examples",
      "description": "Build the ex01 SpMV and ex02 SpGEMM examples with the CPU preset",
      "configurePreset": "cpu",
      "targets": [
        "ex01_spmv",
        "ex02_spgemm"
      ]
    },
    {
      "name": "build_mkl_spmv",
      "description": "Build the oneMKL SpMV benchmark",
      "displayName": "Build oneMKL SpMV Benchmark",
      "configurePreset": "config-full",
      "targets": [
        "bench_mkl_spmv"
      ]
    },
    {
      "name": "macos-openmp",
      "displayName": "Build macOS + OpenMP + MPI",
      "configurePreset": "macos-openmp"
    }
  ],
  "testPresets": [
    {
      "name": "macos-openmp",
      "displayName": "Test macOS + OpenMP + MPI",
      "configurePreset": "macos-openmp",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
