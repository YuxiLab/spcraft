@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG)
find_dependency(Eigen3 5.0 CONFIG)
find_dependency(fmt 10.0 CONFIG)
find_dependency(fast_matrix_market CONFIG)
find_dependency(cxxopts 3.3.1 CONFIG)
if(@OpenMP_CXX_FOUND@)
	find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@SPCRAFT_USE_MPI@)
	find_dependency(MPI COMPONENTS CXX)
endif()
if(@SPCRAFT_USE_MKL@)
	set(MKL_LINK dynamic)
	set(MKL_THREADING gnu_thread)
	set(MKL_INTERFACE lp64)
	find_dependency(MKL CONFIG)
endif()
if(@SPCRAFT_USE_CUDA@)
	find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SPCraftTargets.cmake")
check_required_components(SPCraft)
